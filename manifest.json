{
    "name": "UTMDebugger",
    "version": "1.0",
    "description": "A Chrome extension to debug UTM tracking parameters in URLs",
    "manifest_version": 3,
    "background": {
        "service_worker": "dist/background.js",
        "type": "module"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "webRequest",
        "tabs"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_popup": "dist/src/popup.html",
        "default_icon": "dist/icons/icon-inactive.png"
    }

}